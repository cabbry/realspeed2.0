<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"             
             x:Class="RealSpeed2.MainPage"          
             >

    <!-- Row 1 holds the map: collapsed to 0 by default, switched to * (half the screen) by "Show Map". -->
    <Grid x:Name="rootGrid"
          RowDefinitions="*,0">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25">

                <Label
                    x:Name="lblRealSpeed"
                    Text="{Binding RealSpeed}"
                    Style="{StaticResource Speed}"
                    SemanticProperties.HeadingLevel="Level2"
                    SemanticProperties.Description="GPS Real Speed" />

                <Label
                    Text="Km/h"
                    Style="{StaticResource SpeedUnit}"
                    SemanticProperties.HeadingLevel="Level1" />

                <StackLayout x:Name="pnlGPSDetails"
                             IsVisible="False"
                             Padding="10"
                             Margin="10"
                             >
                    <Label
                        Text="GPS :"
                        Style="{StaticResource GPSDetails}"
                        SemanticProperties.HeadingLevel="Level1" />
                    <Label
                        x:Name="lblGPSDetails"
                        Text="{Binding Location}"
                        Style="{StaticResource GPSDetails}"
                        SemanticProperties.HeadingLevel="Level2"
                        SemanticProperties.Description="GPS all details" />
                    <Label
                        Text="Calculated Speed (Haversine Distance / time) :"
                        Style="{StaticResource GPSDetails}"
                        SemanticProperties.HeadingLevel="Level1" />
                    <Label
                     x:Name="lblGPSSpeed"
                     Text="{Binding CalculatedSpeed}"
                     Style="{StaticResource GPSDetails}"
                     SemanticProperties.HeadingLevel="Level2"
                     SemanticProperties.Description="GPS Calculated Speed" />
                    <Label
                        Text="{Binding UpdateCount, StringFormat='Updates received: {0}'}"
                        Style="{StaticResource GPSDetails}" />
                    <Label
                        Text="{Binding LastUpdate, StringFormat='Last update: {0:HH:mm:ss.fff}'}"
                        Style="{StaticResource GPSDetails}" />

                </StackLayout>

                <Button Text="Show GPS details"
                        Style="{StaticResource BtnGPSDetails}"
                        Clicked="OnGetGPSInfoClicked"/>

                <Label
                    x:Name="lblMaxSpeed"
                    Text="{Binding MaxSpeed, StringFormat='Vmax {0} Km/h'}"
                    Style="{StaticResource SpeedUnit}"
                    SemanticProperties.HeadingLevel="Level2"
                    SemanticProperties.Description="Maximum speed reached" />

                <Button Text="Reset Vmax"
                        Style="{StaticResource BtnGPSDetails}"
                        Clicked="OnResetMaxSpeedClicked"/>

                <!-- .NET MAUI Maps has no Windows implementation, so the button is hidden there. -->
                <Button Text="Show Map"
                        Style="{StaticResource BtnGPSDetails}"
                        IsVisible="{OnPlatform Default=True, WinUI=False}"
                        Clicked="OnShowMapClicked"/>

                <Label
                    x:Name="lblGPSLog"
                    Text=""
                    Style="{StaticResource SubHeadline}"
                    SemanticProperties.HeadingLevel="Level2"
                    SemanticProperties.Description="GPS logs" />

            </VerticalStackLayout>

        </ScrollView>

        <!-- The map itself is created in code on first use (see OnShowMapClicked). -->
        <ContentView x:Name="mapHost"
                     Grid.Row="1"
                     IsVisible="False" />

    </Grid>

</ContentPage>
